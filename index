<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Blastr for Artists</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Mono:wght@400;700&family=Great+Vibes&display=swap" rel="stylesheet">
<style>
:root{--y:#ffd400;--p:#8b3dff;--g:#19e68c;--r:#ff3b4e;--bg:#0a0710;--card:rgba(255,255,255,.06);--bd:rgba(255,255,255,.12);--font:'Syne',sans-serif;--mono:'Space Mono',monospace}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:var(--bg);color:#fff;font-family:var(--font);overflow:hidden}
button,input,select,textarea{font:inherit;color:inherit}
#bg{position:fixed;inset:0;z-index:0;overflow:hidden;background:radial-gradient(circle at 50% 120%,#1a0b30,#0a0710 70%)}
.blob{position:absolute;width:46vmax;height:46vmax;border-radius:50%;filter:blur(90px);opacity:.5;animation:drift 18s ease-in-out infinite alternate}
.b1{background:var(--p);top:-15%;left:-10%}.b2{background:var(--y);bottom:-20%;right:-10%;animation-delay:-5s;opacity:.38}
.b3{background:var(--g);top:30%;left:55%;animation-delay:-9s;opacity:.3}.b4{background:var(--r);bottom:-10%;left:5%;animation-delay:-13s;opacity:.35}
@keyframes drift{to{transform:translate(12vw,-10vh) scale(1.25) rotate(40deg)}}
#eq{position:absolute;bottom:0;left:0;right:0;height:38vh;display:flex;align-items:flex-end;gap:6px;padding:0 6px;opacity:.35}
#eq i{flex:1;border-radius:6px 6px 0 0;animation:bar 1.2s ease-in-out infinite alternate;transform-origin:bottom}
@keyframes bar{from{transform:scaleY(.12)}to{transform:scaleY(1)}}
.scr{position:fixed;inset:0;z-index:1;display:none}.scr.on{display:flex}
/* LOGIN */
#login{align-items:center;justify-content:center;gap:0}
#brand{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;transition:.9s cubic-bezier(.7,0,.2,1);cursor:pointer}
.logo{font-weight:800;font-size:clamp(54px,9vw,120px);letter-spacing:-3px;display:flex;align-items:baseline;line-height:1}
.logo .B{display:inline-block;background:linear-gradient(135deg,var(--y),var(--r) 60%,var(--p));-webkit-background-clip:text;background-clip:text;color:transparent;transform:scale(0);animation:pop .7s .2s cubic-bezier(.3,1.8,.5,1) forwards}
@keyframes pop{to{transform:scale(.45)}}
.logo .rest{display:inline-block;overflow:hidden;max-width:0;opacity:0;white-space:nowrap;background:linear-gradient(90deg,var(--p),var(--g));-webkit-background-clip:text;background-clip:text;color:transparent;padding-right:.1em;transition:max-width 1.1s cubic-bezier(.2,.9,.2,1),opacity .6s}
.logo.x .B{animation:grow .9s forwards}.logo.x .rest{max-width:5em;opacity:1}
@keyframes grow{from{transform:scale(.45)}to{transform:scale(1)}}
.fa{display:flex;gap:.18em;margin-top:6px;font-weight:800;font-size:clamp(26px,4.2vw,56px);color:var(--y);height:1.3em}
.pz{position:relative;padding:0 .35em;background:rgba(255,212,0,.14);border:2px solid var(--y);border-radius:12px;opacity:0;transform:translate(var(--x),var(--y2)) rotate(var(--r2))}
.pz::after{content:"";position:absolute;right:-.28em;top:50%;width:.4em;height:.4em;margin-top:-.2em;border-radius:50%;background:var(--bg);border:2px solid var(--y);z-index:2}
.pz:last-child::after{display:none}
.fa.go .pz{animation:snap .9s var(--d) cubic-bezier(.3,1.4,.5,1) forwards}
@keyframes snap{to{opacity:1;transform:none}}
.sig{font-family:var(--mono);font-size:clamp(11px,1.2vw,15px);letter-spacing:.35em;text-transform:uppercase;margin-top:20px;color:#fffb;opacity:0;transform:translateY(12px)}
.sig.go{animation:fup 1s forwards}
@keyframes fup{to{opacity:1;transform:none}}
@keyframes write{to{clip-path:inset(-10% 0 -30% 0)}}
#card{width:0;opacity:0;overflow:hidden;transition:.9s cubic-bezier(.7,0,.2,1)}
#login.done #card{width:min(470px,92vw);opacity:1;margin-right:4vw}
#login.done #brand{transform:scale(.72)}
.panel{width:min(470px,92vw);max-height:90vh;overflow:auto;background:rgba(15,10,25,.72);backdrop-filter:blur(22px);border:1px solid var(--bd);border-radius:26px;padding:28px;box-shadow:0 30px 80px #0008}
.panel::-webkit-scrollbar,.main::-webkit-scrollbar{width:6px}.panel::-webkit-scrollbar-thumb,.main::-webkit-scrollbar-thumb{background:#fff3;border-radius:9px}
h2{font-size:26px;letter-spacing:-.5px}h3{font-size:17px}
.sub{color:#fffa;font-family:var(--mono);font-size:12px;margin:6px 0 16px}
.tabs{display:flex;background:#0006;border-radius:14px;padding:4px;margin-bottom:16px}
.tabs button{flex:1;padding:10px;border:0;background:none;border-radius:11px;cursor:pointer;font-weight:700;font-size:13px}
.tabs .a{background:linear-gradient(135deg,var(--p),var(--r))}
label{display:block;font-family:var(--mono);font-size:11px;color:#fffb;margin:11px 0 5px;text-transform:uppercase;letter-spacing:.5px}
label b{color:var(--r)}
input,select,textarea{width:100%;padding:12px 14px;background:#0007;border:1px solid var(--bd);border-radius:12px;outline:0;transition:.2s}
input:focus,select:focus,textarea:focus{border-color:var(--y);box-shadow:0 0 0 3px #ffd40033}
input:disabled{opacity:.5;cursor:not-allowed;background:#fff1}
option{background:#150d24}
.row{display:flex;gap:10px}.row>*{flex:1}
.btn{width:100%;margin-top:18px;padding:14px;border:0;border-radius:14px;font-weight:800;font-size:15px;cursor:pointer;color:#111;background:linear-gradient(135deg,var(--y),var(--g));transition:.2s}
.btn:hover{transform:translateY(-2px);filter:brightness(1.1)}
.btn.sec{background:#fff1;color:#fff;border:1px solid var(--bd)}
.hide{display:none!important}
.note{font-size:11px;color:#fff9;font-family:var(--mono);margin-top:8px}
/* SETUP */
#setup{align-items:center;justify-content:center}
#setup .panel{width:min(760px,94vw)}
.steps{display:flex;gap:8px;margin-bottom:14px}.steps i{flex:1;height:5px;border-radius:9px;background:#fff2}.steps i.on{background:linear-gradient(90deg,var(--y),var(--g))}
.up{display:flex;gap:14px;align-items:center}
.av{width:84px;height:84px;border-radius:50%;background:conic-gradient(var(--y),var(--r),var(--p),var(--g),var(--y));display:grid;place-items:center;font-size:28px;cursor:pointer;flex:none}
.bn{width:100%;border-radius:14px;background:linear-gradient(120deg,#00e5ff,#1a5cff);display:grid;place-items:center;font-weight:800;font-size:clamp(14px,2.4vw,24px);aspect-ratio:3/1;transition:.4s;margin-top:8px;letter-spacing:-.3px}
.chips{display:flex;gap:8px;flex-wrap:wrap}.chips button{padding:7px 13px;border-radius:99px;border:1px solid var(--bd);background:#fff1;cursor:pointer;font-family:var(--mono);font-size:11px}.chips .a{background:var(--y);color:#111}
.vbox{margin-top:12px;padding:14px;border-radius:16px;border:1px dashed var(--y);background:#ffd40012;font-size:13px}
.vbox ul{margin:6px 0 0 18px;color:#fffd;line-height:1.7}
.chk{display:flex;gap:12px;align-items:flex-start;padding:13px;margin-top:10px;background:#fff1;border:1px solid var(--bd);border-radius:14px;font-size:13px;cursor:pointer;line-height:1.5}
.chk input{width:20px;height:20px;accent-color:var(--g);margin-top:2px;flex:none}
.chk small{display:block;color:#fff9;font-family:var(--mono);font-size:11px}
/* DASH */
#dash{background:#0a0710cc}
#side{width:250px;flex:none;background:#0d0818ee;border-right:1px solid var(--bd);padding:18px 12px;display:flex;flex-direction:column;gap:4px;transition:.35s;overflow:hidden}
#side.col{width:78px}
.sl{display:flex;align-items:center;justify-content:space-between;padding:4px 8px 18px}
.sl .logo{font-size:26px;letter-spacing:-1px}.sl .logo .B,.sl .logo .rest{animation:none;transform:none;max-width:5em;opacity:1}
.sl small{font-family:var(--mono);font-size:9px;color:var(--y);display:block}
#tg{border:0;background:#fff1;width:32px;height:32px;border-radius:9px;cursor:pointer;flex:none}
#side.col .sl .logo .rest,#side.col .sl small,#side.col .t{display:none}
.nv{display:flex;align-items:center;gap:14px;padding:12px;border:0;background:none;border-radius:13px;cursor:pointer;font-weight:600;font-size:14px;text-align:left;white-space:nowrap;color:#fffc;transition:.2s}
.nv:hover{background:#fff1}.nv.a{background:linear-gradient(135deg,#8b3dff55,#ff3b4e44);color:#fff;box-shadow:inset 3px 0 var(--y)}
.nv span:first-child{font-size:19px;width:26px;text-align:center;flex:none}
.me{margin-top:auto;display:flex;gap:10px;align-items:center;padding:10px;background:#fff1;border-radius:14px;white-space:nowrap}
.me .av{width:36px;height:36px;font-size:14px}
.main{flex:1;overflow:auto;padding:28px 34px 50px}
.view{display:none;animation:in .5s}.view.on{display:block}
@keyframes in{from{opacity:0;transform:translateY(16px)}}
.hero{padding:26px;border-radius:24px;background:linear-gradient(120deg,#8b3dffcc,#ff3b4ecc 60%,#ffd400cc);margin-bottom:20px}
.hero h1{font-size:clamp(24px,3.4vw,40px);letter-spacing:-1px}.hero p{font-family:var(--mono);font-size:12px;margin-top:6px;opacity:.9}
.grid{display:grid;gap:14px}.g4{grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}.g3{grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}.g2{grid-template-columns:repeat(auto-fit,minmax(340px,1fr))}
.c{background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:18px}
.st small{font-family:var(--mono);font-size:11px;color:#fffa}.st b{display:block;font-size:30px;margin:4px 0;letter-spacing:-1px}
.up2{color:var(--g);font-family:var(--mono);font-size:12px}.dn{color:var(--r);font-family:var(--mono);font-size:12px}
.ac{cursor:pointer;transition:.25s;position:relative;overflow:hidden;min-height:128px}
.ac:hover{transform:translateY(-5px) scale(1.02);border-color:var(--y)}
.ac .ic{font-size:30px}.ac h3{margin-top:8px}.ac p{font-size:12px;color:#fffa;margin-top:4px;line-height:1.5}
.ac.big{background:linear-gradient(135deg,var(--p),var(--r));grid-column:span 2}
.sec{display:flex;justify-content:space-between;align-items:center;margin:26px 0 12px}
.ch{height:220px;position:relative}.ch svg{width:100%;height:100%}
.lg{display:flex;gap:14px;font-family:var(--mono);font-size:11px;margin-top:8px;flex-wrap:wrap}.lg i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px}
.pie{width:170px;height:170px;border-radius:50%;margin:auto;background:conic-gradient(var(--y) 0 38%,var(--p) 0 66%,var(--g) 0 86%,var(--r) 0 100%);-webkit-mask:radial-gradient(circle 52px,#0000 98%,#000);mask:radial-gradient(circle 52px,#0000 98%,#000);animation:spin 1.2s}
@keyframes spin{from{transform:rotate(-120deg) scale(.6);opacity:0}}
.bars .r{display:flex;align-items:center;gap:10px;font-size:12px;margin:10px 0;font-family:var(--mono)}.bars .r span:first-child{width:110px;flex:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bars .t2{flex:1;height:10px;background:#fff1;border-radius:9px;overflow:hidden}.bars .t2 i{display:block;height:100%;border-radius:9px;background:linear-gradient(90deg,var(--p),var(--y));animation:w 1.2s}
@keyframes w{from{width:0!important}}
table{width:100%;border-collapse:collapse;font-size:13px}th{font-family:var(--mono);font-size:11px;text-align:left;color:#fff9;padding:8px;text-transform:uppercase}td{padding:12px 8px;border-top:1px solid var(--bd)}
.cov{width:38px;height:38px;border-radius:9px;display:inline-block;vertical-align:middle;margin-right:10px}
.drop{border:2px dashed var(--bd);border-radius:20px;padding:40px;text-align:center;cursor:pointer;transition:.2s;background:#fff05}.drop:hover{border-color:var(--y);background:#ffd40010}
.tag{padding:3px 10px;border-radius:99px;font-size:10px;font-family:var(--mono);background:#19e68c33;color:var(--g)}
.toast{position:fixed;bottom:26px;left:50%;transform:translate(-50%,90px);background:var(--y);color:#111;padding:12px 22px;border-radius:99px;font-weight:700;z-index:9;transition:.4s}.toast.on{transform:translate(-50%,0)}
@media(max-width:760px){#login.done #brand{display:none}#side{width:78px}#side .t,#side .sl small,#side .logo .rest{display:none}.ac.big{grid-column:auto}.main{padding:18px}}

.i{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;vertical-align:-2px;margin-right:6px}
.feat{display:flex;gap:8px;margin-bottom:14px}.feat span{flex:1;padding:9px 4px;border:1px solid var(--bd);border-radius:12px;font-family:var(--mono);font-size:10px;text-align:center;color:#fffc;background:#fff07}
.vb{display:flex;gap:10px;height:200px;align-items:flex-end;margin-top:14px}
.vc{flex:1;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:6px;font-family:var(--mono);font-size:10px;color:#fffa}
.vc i{width:100%;border-radius:8px 8px 0 0;background:linear-gradient(180deg,var(--y),var(--p));transform-origin:bottom;animation:up 1s backwards;transition:.2s}.vc i:hover{filter:brightness(1.4)}
@keyframes up{from{transform:scaleY(0)}}@keyframes rg{from{stroke-dashoffset:201}}@keyframes fd{from{opacity:0}}@keyframes d1{to{stroke-dashoffset:0}}
@keyframes fi{from{opacity:0;transform:scale(.4)}}@keyframes pl{0%{box-shadow:0 0 0 0 #19e68c88}100%{box-shadow:0 0 0 9px #19e68c00}}
.hm{display:grid;grid-template-columns:34px repeat(12,1fr);gap:4px;font-family:var(--mono);font-size:10px;align-items:center;color:#fffa}
.hm i{height:20px;border-radius:5px;background:var(--p);animation:fi .6s backwards}
.pulse{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--g);margin-right:6px;animation:pl 1.4s infinite}
.stk{display:flex;height:16px;border-radius:9px;overflow:hidden;gap:2px;margin:12px 0}.stk i{animation:w 1.2s}
.live{font-family:var(--mono);font-size:12px;color:#fffb}.live b{font-size:34px;color:var(--g);font-family:var(--font);letter-spacing:-1px;margin-right:6px}

.fl{position:relative;margin-top:12px}.fl label{position:absolute;left:14px;top:16px;margin:0;pointer-events:none;transition:.2s;font-size:11px;z-index:1}
.fl input,.fl select{padding:23px 14px 8px}.fl input:focus+label,.fl input:not(:placeholder-shown)+label,.fl.sel label{top:7px;font-size:9px;color:var(--y)}
.eye{position:absolute;right:10px;top:14px;border:0;background:none;cursor:pointer;font-size:15px;opacity:.7}
.pw{height:4px;background:#fff2;border-radius:4px;margin-top:6px;overflow:hidden}.pw i{display:block;height:100%;width:0;transition:.3s}
.rf{display:flex;justify-content:space-between;font-family:var(--mono);font-size:11px;color:#fffb;margin-top:12px}.rf input{width:14px;padding:0;vertical-align:-3px;margin-right:6px;accent-color:var(--g)}.rf a{color:var(--y);cursor:pointer}
.or{display:flex;align-items:center;gap:10px;margin:16px 0 4px;font-family:var(--mono);font-size:10px;color:#fff9}.or::before,.or::after{content:"";flex:1;height:1px;background:var(--bd)}
.so{display:flex;gap:8px;margin-top:10px}.soc{flex:1;padding:11px;border-radius:12px;border:1px solid var(--bd);background:#fff1;cursor:pointer;font-weight:700;font-size:12px;display:flex;align-items:center;justify-content:center;gap:8px}.soc b{width:20px;height:20px;border-radius:50%;display:grid;place-items:center;font-size:11px;color:#111}
.btn,.soc,.tabs button{position:relative;overflow:hidden}.rip{position:absolute;border-radius:50%;background:#fff6;transform:scale(0);animation:rp .6s;pointer-events:none}@keyframes rp{to{transform:scale(4);opacity:0}}
#notes{position:absolute;inset:0;pointer-events:none}.nt{position:absolute;bottom:-50px;opacity:0;animation:nf linear infinite;text-shadow:0 0 14px currentColor}
@keyframes nf{10%{opacity:.5}50%{transform:translate(30px,-55vh) rotate(18deg)}100%{transform:translate(-20px,-110vh) rotate(-12deg);opacity:0}}
.tick{margin-top:22px;padding:9px 18px;border-radius:99px;background:#fff1;border:1px solid var(--bd);font-family:var(--mono);font-size:12px;opacity:0;transform:translateY(12px);transition:.8s;white-space:nowrap}.tick.on{opacity:1;transform:none}
.tick b{color:var(--y);font-size:15px}#tk{display:inline-block;transition:.35s}#tk.o{opacity:0;transform:translateY(-8px)}
.qt{margin-top:16px;max-width:380px;text-align:center;font-size:14px;line-height:1.5;color:#fffd;min-height:64px;transition:.5s;opacity:0}.qt.on{opacity:1}.qt small{display:block;margin-top:6px;font-family:var(--mono);font-size:11px;color:var(--g)}
.top{display:flex;align-items:center;gap:10px;position:sticky;top:-28px;z-index:20;margin:-28px -34px 20px;padding:14px 34px;background:#0a0710e6;backdrop-filter:blur(14px);border-bottom:1px solid var(--bd)}
.srch{flex:0 1 380px;margin-right:auto;display:flex;align-items:center;gap:10px;padding:10px 14px;background:#fff1;border:1px solid var(--bd);border-radius:14px;cursor:pointer;color:#fffa;font-size:13px;transition:.2s}.srch:hover{border-color:var(--y)}
.srch kbd,#cp kbd{margin-left:auto;font-family:var(--mono);font-size:10px;background:#fff2;padding:2px 7px;border-radius:6px;color:#fffb}
.wr{position:relative}.ib{position:relative;width:40px;height:40px;border-radius:12px;border:1px solid var(--bd);background:#fff1;cursor:pointer;font-size:17px;transition:.2s}.ib:hover{border-color:var(--y);transform:translateY(-2px)}
.ib .dot{position:absolute;top:-5px;right:-5px;min-width:18px;height:18px;border-radius:9px;background:var(--r);font-size:10px;font-weight:800;display:grid;place-items:center}
.pop{position:absolute;top:54px;right:0;width:340px;max-height:430px;overflow:auto;background:#140d22f5;backdrop-filter:blur(20px);border:1px solid var(--bd);border-radius:18px;padding:14px;display:none;box-shadow:0 20px 60px #000a}.pop.on{display:block;animation:in .25s}
.n2{display:flex;gap:10px;padding:10px;border-radius:12px;font-size:12px;line-height:1.4}.n2:hover{background:#fff1}.n2.u{box-shadow:inset 3px 0 var(--y)}.n2 .e{font-size:20px}.n2 small{display:block;color:#fff9;font-family:var(--mono);font-size:10px}
.sw{display:flex;gap:12px;flex-wrap:wrap}.sw button{width:46px;height:46px;border-radius:50%;border:3px solid transparent;cursor:pointer;transition:.2s}.sw button:hover{transform:scale(1.1)}.sw button.on{border-color:#fff}
#cp{position:fixed;inset:0;z-index:50;display:none;align-items:flex-start;justify-content:center;padding-top:14vh;background:#000a;backdrop-filter:blur(6px)}#cp.on{display:flex}
#cp .bx{width:min(560px,92vw);background:#140d22;border:1px solid var(--bd);border-radius:20px;overflow:hidden;animation:in .25s}
#cp input{border:0;border-radius:0;border-bottom:1px solid var(--bd);padding:18px;font-size:16px;background:transparent;box-shadow:none!important}
#cp .it{display:flex;align-items:center;gap:12px;padding:12px 18px;cursor:pointer;font-size:14px}#cp .it.a{background:linear-gradient(90deg,color-mix(in srgb,var(--p) 40%,transparent),transparent);box-shadow:inset 3px 0 var(--y)}
#dash .hero:not([style]){background:linear-gradient(120deg,color-mix(in srgb,var(--p) 80%,transparent),color-mix(in srgb,var(--r) 80%,transparent) 60%,color-mix(in srgb,var(--y) 80%,transparent))}
#dash .nv.a{background:linear-gradient(135deg,color-mix(in srgb,var(--p) 33%,transparent),color-mix(in srgb,var(--r) 27%,transparent))}
.bdg{text-align:center;padding:16px 10px}.bdg .rg{width:72px;height:72px;margin:0 auto 8px;position:relative}.bdg .rg svg{position:absolute;inset:0}.bdg .em{position:absolute;inset:0;display:grid;place-items:center;font-size:26px}
.bdg.lk .em{filter:grayscale(1);opacity:.5}.bdg.ul{border-color:var(--y);box-shadow:0 0 30px color-mix(in srgb,var(--y) 18%,transparent)}.bdg b{font-size:13px;display:block}.bdg small{font-family:var(--mono);font-size:10px;color:#fff9}
.fd{display:flex;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--bd);font-size:13px;animation:slin .5s}@keyframes slin{from{opacity:0;transform:translateX(-24px)}}
.fd .e{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:#fff1;font-size:16px;flex:none}.fd small{margin-left:auto;font-family:var(--mono);font-size:10px;color:#fff8;white-space:nowrap}
.ch2{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.ch2 button{border:0;background:#fff1;width:30px;height:30px;border-radius:9px;cursor:pointer;margin-left:4px}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;text-align:center;font-family:var(--mono);font-size:11px}.cal span{padding:9px 0;border-radius:10px;position:relative}.cal .h{color:#fff8;font-size:10px;padding:2px 0}
.cal .t{outline:2px solid var(--y)}.cal .rl{background:linear-gradient(135deg,var(--p),var(--r));font-weight:700;cursor:pointer}.cal .rl::after{content:"";position:absolute;bottom:3px;left:50%;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:var(--y)}
